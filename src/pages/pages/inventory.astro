---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Equipment Rental | Elitez FMCG Singapore"
  description="Rent activation equipment for FMCG roadshows and brand activations in Singapore — counters, displays, fridges, tents and more."
  canonical="https://fmcg.elitez.ai/pages/inventory"
  keywords="activation equipment rental Singapore, roadshow equipment Singapore, FMCG rental inventory"
>
<Fragment slot="head">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Elitez FMCG",
  "url": "https://fmcg.elitez.ai/",
  "logo": "https://fmcg.elitez.ai/assets/logo-nav.png",
  "telephone": "+65 8180 0994",
  "email": "fmcg@elitez.asia",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 Kallang Ave, CT Hub #03-08",
    "addressLocality": "Singapore",
    "postalCode": "339407",
    "addressCountry": "SG"
  },
  "areaServed": "SG",
  "priceRange": "$$"
}
</script>
</Fragment>
<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --orange: #FF5500; --orange-hover: #E84A00; --orange-pale: #FFF3EE;
    --black: #111; --white: #fff; --gray: #F4F4F2;
    --mid-gray: #888; --border: #E8E8E5; --text-muted: #777; --nav-h: 72px;
  }
  html { scroll-behavior: smooth; }
  body { font-family: 'Barlow', sans-serif; background: var(--white); color: var(--black); -webkit-font-smoothing: antialiased; overflow-x: hidden; }

  /* NAV */
  nav { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); background: rgba(255,255,255,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; transition: box-shadow 0.3s; }
  nav.scrolled { box-shadow: 0 2px 24px rgba(0,0,0,0.08); }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo img { height: 44px; width: auto; }
  .nav-logo-text { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 3px; color: var(--black); }
  .nav-logo-text span { color: var(--orange); }
  .nav-links { display: flex; align-items: center; gap: 24px; list-style: none; }
  .nav-links a { font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #888; text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--black); }
  .nav-cta { background: var(--orange) !important; color: var(--white) !important; padding: 10px 22px; border-radius: 3px; transition: background 0.2s !important; }
  .nav-cta:hover { background: var(--orange-hover) !important; }
  /* SERVICES DROPDOWN */
  .has-dropdown { position: relative; align-self: stretch; display: flex; align-items: center; }
  .has-dropdown > a { display: flex; align-items: center; gap: 4px; }
  .has-dropdown > a::after { content: '▾'; font-size: 11px; opacity: 0.5; transition: opacity 0.2s; }
  .has-dropdown:hover > a::after { opacity: 1; }
  .nav-dropdown { position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(-4px); background: var(--white); border: 1px solid var(--border); border-top: 3px solid var(--orange); border-radius: 0 0 4px 4px; padding: 4px 0; min-width: 220px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; z-index: 200; }
  .nav-dropdown::before { display: none; }
  .has-dropdown:hover .nav-dropdown { opacity: 1; pointer-events: all; transform: translateX(-50%) translateY(0); }
  .nav-dropdown a { display: block !important; padding: 9px 18px; font-family: 'Barlow', sans-serif !important; font-size: 11px !important; font-weight: 700 !important; letter-spacing: 1.5px !important; text-transform: uppercase !important; color: #888 !important; background: none !important; transition: color 0.15s, background 0.15s !important; white-space: nowrap; border-radius: 0 !important; }
  .nav-dropdown a:hover { color: var(--orange) !important; background: var(--orange-pale) !important; }

  .fade-up { opacity: 0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  /* HERO */
  .page-hero { padding-top: var(--nav-h); background: var(--black); position: relative; overflow: hidden; }
  .page-hero::before { content: 'RENTAL'; position: absolute; top: 0; right: -20px; font-family: 'Bebas Neue', cursive; font-size: 220px; letter-spacing: 8px; color: rgba(255,255,255,0.02); pointer-events: none; line-height: 1; }
  .hero-inner { padding: 72px 48px 56px; }
  .breadcrumb { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 20px; }
  .breadcrumb a { color: var(--orange); text-decoration: none; }
  .hero-tag { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,85,0,0.15); border: 1px solid rgba(255,85,0,0.25); padding: 7px 14px; margin-bottom: 24px; }
  .hero-tag span { font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--orange); }
  h1 { font-family: 'Bebas Neue', cursive; font-size: clamp(52px, 7vw, 84px); letter-spacing: 2px; color: var(--white); line-height: 0.92; margin-bottom: 20px; }
  h1 .accent { color: var(--orange); }
  .hero-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; }
  .hero-desc { font-size: 16px; font-weight: 300; line-height: 1.7; color: rgba(255,255,255,0.55); max-width: 480px; margin-bottom: 32px; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-orange { display: inline-flex; align-items: center; gap: 8px; background: var(--orange); color: #fff; font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 13px 26px; text-decoration: none; transition: background 0.2s, transform 0.15s; }
  .btn-orange:hover { background: var(--orange-hover); transform: translateY(-1px); }
  .btn-ghost { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: rgba(255,255,255,0.65); border: 1px solid rgba(255,255,255,0.18); font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding: 13px 26px; text-decoration: none; transition: all 0.2s; }
  .btn-ghost:hover { border-color: rgba(255,255,255,0.45); color: var(--white); }

  /* HERO STATS */
  .hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .hero-stat { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); padding: 24px 20px; }
  .hero-stat-num { font-family: 'Bebas Neue', cursive; font-size: 36px; letter-spacing: 2px; color: var(--orange); line-height: 1; margin-bottom: 4px; }
  .hero-stat-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.35); }

  /* RENTAL INTRO */
  .intro-band { background: var(--orange); padding: 40px 48px; display: flex; align-items: center; gap: 64px; }
  .intro-band-text { font-size: 17px; font-weight: 300; line-height: 1.65; color: rgba(255,255,255,0.85); max-width: 680px; }
  .intro-band-text strong { color: var(--white); font-weight: 700; }
  .intro-band-cta { flex-shrink: 0; }
  .btn-white { display: inline-flex; align-items: center; gap: 8px; background: var(--white); color: var(--orange); font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 13px 26px; text-decoration: none; white-space: nowrap; transition: transform 0.15s; }
  .btn-white:hover { transform: translateY(-2px); }

  /* CATALOGUE SECTION */
  .catalogue-section { padding: 80px 48px; background: var(--white); }
  .catalogue-header { margin-bottom: 48px; }
  .section-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; color: var(--orange); margin-bottom: 12px; }
  .section-title { font-family: 'Bebas Neue', cursive; font-size: clamp(36px, 4.5vw, 56px); letter-spacing: 2px; color: var(--black); line-height: 1; margin-bottom: 20px; }
  .section-title .accent { color: var(--orange); }
  .catalogue-controls { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 28px; padding-bottom: 28px; border-bottom: 2px solid var(--black); }
  .filter-tabs { display: flex; gap: 0; }
  .filter-tab { font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding: 10px 18px; border: 1px solid var(--border); border-right: none; background: var(--white); color: var(--mid-gray); cursor: pointer; transition: all 0.2s; }
  .filter-tab:first-child { border-radius: 3px 0 0 3px; }
  .filter-tab:last-child { border-right: 1px solid var(--border); border-radius: 0 3px 3px 0; }
  .filter-tab.active, .filter-tab:hover { background: var(--orange); color: var(--white); border-color: var(--orange); }
  .item-count { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 2px; color: var(--text-muted); }
  .item-count span { color: var(--orange); font-weight: 600; }

  /* INVENTORY GRID */
  .inventory-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }

  .inv-card { border: 1px solid var(--border); background: var(--white); overflow: hidden; transition: box-shadow 0.3s, transform 0.3s; display: flex; flex-direction: column; }
  .inv-card:hover { box-shadow: 0 12px 48px rgba(0,0,0,0.1); transform: translateY(-3px); }

  .inv-img { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--gray); }
  .inv-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
  .inv-placeholder-icon { font-size: 52px; opacity: 0.4; }
  .inv-placeholder-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--mid-gray); text-align: center; }
  .inv-illo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .warehouse-band { overflow: hidden; border-bottom: 1px solid var(--border); }
  .warehouse-band img { width: 100%; height: auto; display: block; }
  .inv-cat-badge { position: absolute; top: 12px; left: 12px; font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; }
  .badge-games { background: rgba(255,85,0,0.12); color: var(--orange); border: 1px solid rgba(255,85,0,0.2); }
  .badge-av { background: rgba(17,17,17,0.08); color: var(--black); border: 1px solid rgba(17,17,17,0.15); }
  .badge-display { background: rgba(0,150,100,0.1); color: #008060; border: 1px solid rgba(0,150,100,0.2); }
  .inv-qty-badge { position: absolute; top: 12px; right: 12px; background: var(--black); color: var(--white); font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 600; letter-spacing: 1px; padding: 4px 10px; }
  .inv-status-badge { position: absolute; bottom: 12px; left: 12px; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; padding: 4px 10px; border-radius: 2px; font-weight: 600; }
  .inv-status-available { background: rgba(0,200,100,0.12); color: #00c864; border: 1px solid rgba(0,200,100,0.25); }
  .inv-status-request { background: rgba(255,85,0,0.08); color: var(--orange); border: 1px solid rgba(255,85,0,0.2); }

  .inv-body { padding: 20px 20px 0; flex: 1; }
  .inv-name { font-family: 'Bebas Neue', cursive; font-size: 20px; letter-spacing: 1.5px; color: var(--black); line-height: 1.1; margin-bottom: 8px; }
  .inv-desc { font-size: 13px; line-height: 1.6; color: var(--text-muted); margin-bottom: 14px; }
  .inv-specs { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
  .inv-spec { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .inv-spec-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--mid-gray); min-width: 80px; }
  .inv-spec-val { color: var(--black); font-weight: 500; }

  .inv-footer { padding: 16px 20px 20px; border-top: 1px solid var(--border); margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .inv-price { }
  .inv-price-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--mid-gray); }
  .inv-price-val { font-family: 'Bebas Neue', cursive; font-size: 20px; letter-spacing: 1px; color: var(--orange); }
  .btn-enquire { display: inline-flex; align-items: center; gap: 6px; background: var(--black); color: var(--white); font-family: 'Barlow', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 10px 18px; text-decoration: none; transition: background 0.2s; white-space: nowrap; }
  .btn-enquire:hover { background: var(--orange); }

  /* LOGISTICS NOTE */
  .logistics-note { background: var(--gray); border-left: 3px solid var(--orange); padding: 20px 24px; margin-top: 40px; display: flex; align-items: flex-start; gap: 16px; }
  .logistics-note-icon { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
  .logistics-note p { font-size: 14px; line-height: 1.65; color: var(--text-muted); }
  .logistics-note p strong { color: var(--black); }

  /* RENTAL FORM */
  .form-section { background: var(--black); padding: 80px 48px; }
  .form-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .form-info .section-title { color: var(--white); }
  .form-info p { font-size: 15px; font-weight: 300; line-height: 1.7; color: rgba(255,255,255,0.5); margin-bottom: 32px; }
  .form-checklist { display: flex; flex-direction: column; gap: 12px; }
  .form-check-item { display: flex; align-items: flex-start; gap: 12px; }
  .form-check-icon { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,85,0,0.15); border: 1px solid rgba(255,85,0,0.25); display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; margin-top: 2px; }
  .form-check-text { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.5; }
  .form-check-text strong { color: rgba(255,255,255,0.85); }

  /* FORM */
  .rental-form { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); padding: 36px 32px; }
  .form-title { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 2px; color: var(--white); margin-bottom: 6px; }
  .form-subtitle { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 28px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 7px; }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--white); font-family: 'Barlow', sans-serif; font-size: 14px; padding: 11px 14px; outline: none; transition: border-color 0.2s; border-radius: 2px;
  }
  .form-group input::placeholder, .form-group textarea::placeholder { color: rgba(255,255,255,0.25); }
  .form-group select { cursor: pointer; }
  .form-group select option { background: #222; color: var(--white); }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--orange); }
  .form-group textarea { resize: vertical; min-height: 100px; }

  /* Enquiry type radios */
  .enquiry-types { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
  .enquiry-type { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .enquiry-type input[type="radio"] { accent-color: var(--orange); width: 15px; height: 15px; flex-shrink: 0; }
  .enquiry-type-label { font-size: 13px; color: rgba(255,255,255,0.7); padding: 8px 14px; border: 1px solid rgba(255,255,255,0.1); border-radius: 2px; transition: all 0.2s; cursor: pointer; }
  .enquiry-type input[type="radio"]:checked + .enquiry-type-label { background: rgba(255,85,0,0.15); border-color: var(--orange); color: var(--orange); }

  /* Item checkboxes */
  .items-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; max-height: 200px; overflow-y: auto; padding-right: 4px; }
  .items-grid::-webkit-scrollbar { width: 4px; }
  .items-grid::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
  .items-grid::-webkit-scrollbar-thumb { background: rgba(255,85,0,0.4); border-radius: 2px; }
  .item-check { display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 7px 10px; border: 1px solid rgba(255,255,255,0.06); border-radius: 2px; transition: all 0.2s; }
  .item-check:hover { border-color: rgba(255,85,0,0.2); background: rgba(255,85,0,0.05); }
  .item-check input[type="checkbox"] { accent-color: var(--orange); width: 14px; height: 14px; flex-shrink: 0; }
  .item-check-label { font-size: 12px; color: rgba(255,255,255,0.6); line-height: 1.3; }

  .form-dates-note { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 1px; color: rgba(255,255,255,0.35); margin: -8px 0 16px; }
  .btn-submit { width: 100%; background: var(--orange); color: var(--white); font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; padding: 15px; border: none; cursor: pointer; margin-top: 8px; transition: background 0.2s; }
  .btn-submit:hover { background: var(--orange-hover); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-success { display: none; text-align: center; padding: 48px 24px; }
  .form-success .success-icon { font-size: 48px; margin-bottom: 16px; }
  .form-success h3 { font-family: 'Bebas Neue', cursive; font-size: 28px; letter-spacing: 2px; color: var(--white); margin-bottom: 8px; }
  .form-success p { font-size: 14px; color: rgba(255,255,255,0.5); }

  /* FOOTER */
  footer { background: #0A0A0A; padding: 32px 48px; border-top: 1px solid rgba(255,255,255,0.06); }
  .footer-bar { display: flex; justify-content: space-between; align-items: center; }
  .footer-logo-img { height: 36px; width: auto; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--white); }
  .footer-copy { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.2); }

  @media (max-width: 900px) {
    nav { padding: 0 24px; } .nav-links { display: none; }
    .hero-inner { padding: 48px 24px 40px; }
    .hero-layout { grid-template-columns: 1fr; gap: 32px; }
    .hero-stats { grid-template-columns: 1fr 1fr 1fr; }
    .intro-band { padding: 36px 24px; flex-direction: column; gap: 24px; }
    .catalogue-section, .form-section { padding: 64px 24px; }
    .inventory-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-layout { grid-template-columns: 1fr; gap: 40px; }
    .form-row { grid-template-columns: 1fr; }
    footer { padding: 32px 24px; }
    .footer-bar { flex-direction: column; gap: 16px; text-align: center; }
    .footer-links { flex-wrap: wrap; justify-content: center; }
  }
  @media (max-width: 600px) {
    .inventory-grid { grid-template-columns: 1fr; }
    .hero-stats { grid-template-columns: 1fr; }
  }
</style>

<!-- HERO -->
<div class="page-hero">
  <div class="hero-inner">
    <div class="breadcrumb"><a href="../">Home</a> / Inventory & Rental</div>
    <div class="hero-layout">
      <div class="fade-up">
        <div class="hero-tag"><span>Equipment Hire Singapore</span></div>
        <h1><span class="accent">ACTIVATION</span><br><span class="accent">INVENTORY</span><br>& RENTAL</h1>
        <p class="hero-desc">From claw machines to cash blow booths — rent our activation equipment for roadshows, brand activations or events. Available to brands, agencies and event companies across Singapore.</p>
        <div class="hero-actions">
          <a href="#catalogue" class="btn-orange">Browse Catalogue ↓</a>
          <a href="#rental-form" class="btn-ghost">Enquire to Rent</a>
        </div>
      </div>
      <div class="hero-stats fade-up">
        <div class="hero-stat">
          <div class="hero-stat-num">11</div>
          <div class="hero-stat-label">Equipment Types</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">50+</div>
          <div class="hero-stat-label">Units Available</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">SG</div>
          <div class="hero-stat-label">Island-Wide Delivery</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- INTRO BAND -->
<div class="intro-band">
  <p class="intro-band-text">We don't just run activations — we own the equipment. <strong>Rent direct from the operator</strong> and skip the middleman. All items are activation-tested, regularly maintained and available with or without our on-ground crew.</p>
  <a href="#rental-form" class="btn-white intro-band-cta">Get Rental Rates →</a>
</div>

<!-- WAREHOUSE BAND -->
<div class="warehouse-band">
  <img src="/assets/img/scene-warehouse.png" alt="Elitez FMCG activation equipment warehouse" loading="lazy">
</div>

<!-- CATALOGUE -->
<section class="catalogue-section" id="catalogue">
  <div class="catalogue-header fade-up">
