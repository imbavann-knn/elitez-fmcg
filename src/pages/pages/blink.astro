<script>
  // Scroll fade-up (page-local; BaseLayout also runs one — harmless, both add .visible)
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.blk .fade-up').forEach((el) => io.observe(el));

  // PostHog — Blink CTA tracking, tagged by audience
  if (typeof posthog !== 'undefined') {
    document.querySelectorAll('a[href*="interest=blink"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const audience = btn.getAttribute('href').includes('subscription') ? 'in_house_team' : 'brand_demo';
        posthog.capture('blink_cta_clicked', { location: 'blink_page', audience });
      });
    });
  }
</script>
</BaseLayout>
