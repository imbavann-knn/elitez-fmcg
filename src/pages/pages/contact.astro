          </div>
        </div>
        <div class="form-group">
          <label>Company / Brand *</label>
          <input type="text" name="company" placeholder="Your company or brand name" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Email Address *</label>
