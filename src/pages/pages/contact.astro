---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Elitez FMCG | Get a Quote"
  description="Get in touch with Elitez FMCG for brand activations, promoter deployment and field marketing services in Singapore."
  canonical="https://fmcg.elitez.ai/pages/contact"
  keywords="contact Elitez FMCG, brand activation quote Singapore, promoter agency contact"
>
