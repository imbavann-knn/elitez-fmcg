            <label class="checkbox-item"><input type="checkbox" name="services" value="merchandising"><span>Supermarket Merchandising</span></label>
            <label class="checkbox-item"><input type="checkbox" name="services" value="contest"><span>Online Contest Management</span></label>
            <label class="checkbox-item"><input type="checkbox" name="services" value="beauty"><span>Beauty & Cosmetics</span></label>
