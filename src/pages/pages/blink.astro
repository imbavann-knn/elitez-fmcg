---
import BaseLayout from '../../layouts/BaseLayout.astro';

const caps = [
  {
    img: 'blink-admin-today-map.webp', frame: 'browser',
    title: 'Live deployment map',
    desc: 'Every check-in and check-out on a map, with late arrivals and no-shows flagged the moment they happen.',
  },
  {
    img: 'blink-client-sales-report.webp', frame: 'browser',
    title: 'Same-day sales reports',
    desc: 'SKU-level sales, promoter-submitted from the floor and ops-verified — in your hands the same day, not month-end.',
  },
  {
    img: 'blink-wa-messages.webp', frame: 'browser',
    title: 'WhatsApp automation',
    desc: 'Shift reminders, confirmations and change notices with old→new details sent automatically. Zero manual chasing.',
  },
  {
    img: 'blink-logistics-week.webp', frame: 'browser',
    title: 'Logistics engine',
    desc: 'Delivery orders, packing checklists and vendor coordination — plus an automatic returns checklist of premiums and client equipment when an outlet’s final shift ends.',
  },
  {
    img: 'blink-inventory-items.webp', frame: 'browser',
    title: 'Inventory at your fingertips',
    desc: 'Everything of yours we hold — counts, brand, expiry, in/out dates — visible in your portal at any time.',
  },
  {
    img: 'blink-promoter-app.webp', frame: 'phone',
    title: 'Promoter quality loop',
    desc: 'Favourite or flag promoters from your dashboard. Ratings, quizzes and blacklists feed straight into the next deployment.',
  },
  {
    img: 'blink-approvals-diff.webp', frame: 'browser',
    title: 'Manager-gated accuracy',
    desc: 'Pay changes, count discrepancies and amendments all require approval — with a plain-English audit trail of who changed what.',
  },
];

const faqs = [
  {
    q: 'Is our data confidential and brand-scoped?',
    a: 'Yes. Each brand’s dashboard is scoped to that brand only — your brand-IC contacts see your campaigns, your sales and your inventory, and nothing from any other client. Reports are delivered to your brand contacts alone.',
  },
  {
    q: 'Do we need to install anything?',
    a: 'No. The client dashboard is a secure web login — open it on any browser, desktop or phone. Nothing to install, nothing to maintain.',
  },
  {
    q: 'Does it work for part-time promoters on basic phones?',
    a: 'Yes. Promoters interact through WhatsApp and a lightweight mobile web app — GPS check-in, sales entry and stock counts all work on an everyday phone. No app-store download required.',
  },
  {
    q: 'What does the Blink subscription include?',
    a: 'For brands running their own promoter teams: deployment scheduling, the live map, WhatsApp automation, sales and stock-count capture, manager approvals with a full audit trail, and onboarding by the team that runs Blink daily. Talk to us about scope and licensing for your team size.',
  },
  {
    q: 'Is Blink Singapore only?',
    a: 'Our promoter roster and retail coverage are Singapore-based today — NTUC, Cold Storage, Giant, Sheng Siong and malls island-wide. For regional needs, reach out and we’ll discuss options through our Elitez Group partners.',
  },
];
---
<BaseLayout
  title="Blink by Elitez — FMCG Activation Platform Singapore"
  description="FMCG field activation platform behind every Elitez campaign — GPS-verified deployment map, same-day SKU sales reports and a live client dashboard, Singapore."
  canonical="https://fmcg.elitez.asia/pages/blink"
  keywords="FMCG field activation platform Singapore, promoter management software Singapore, sampling activation agency live dashboard, brand activation dashboard Singapore, field marketing software"
>
<Fragment slot="head">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Blink",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "FMCG field activation and promoter management platform with a live client dashboard — GPS-verified check-ins, same-day SKU sales reports, WhatsApp automation, logistics and manager-gated approvals.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "SGD", "description": "Included with every Elitez FMCG activation; subscription licensing available for in-house teams." },
  "publisher": {
    "@type": "Organization",
    "name": "Elitez FMCG",
    "url": "https://fmcg.elitez.asia/",
    "logo": "https://fmcg.elitez.asia/assets/logo-nav.webp",
    "telephone": "+65 8180 0994",
    "areaServed": "SG"
  }
}
</script>
</Fragment>

<style>
  .blk { --pad-x: 48px; }
  .blk-container { max-width: 1200px; margin: 0 auto; padding: 0 var(--pad-x); }
  .blk section, .blk .blk-band { position: relative; }

  /* shared type */
  .blk-kicker { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 4px; text-transform: uppercase; color: var(--orange); margin-bottom: 14px; }
  .blk-h2 { font-family: 'Bebas Neue', cursive; font-size: clamp(38px, 5vw, 62px); line-height: 0.98; letter-spacing: 2px; color: var(--black); }
  .blk-h2 span { color: var(--orange); }
  .blk-lead { font-size: 17px; line-height: 1.7; color: var(--text-muted); max-width: 620px; margin-top: 18px; }

  /* frames */
  .blk-browser { border-radius: 10px; overflow: hidden; border: 1px solid var(--border); background: #fff; box-shadow: 0 24px 60px -20px rgba(17,17,17,0.28); }
  .blk-browser-bar { height: 36px; background: #f3f3f1; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 7px; padding: 0 14px; }
  .blk-dot { width: 11px; height: 11px; border-radius: 50%; background: #d9d9d5; }
  .blk-url { flex: 1; height: 20px; margin-left: 8px; border-radius: 4px; background: #fff; border: 1px solid var(--border); display: flex; align-items: center; padding: 0 10px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: #9a9a97; letter-spacing: 0.5px; overflow: hidden; white-space: nowrap; }
  .blk-browser img { display: block; width: 100%; height: auto; }
  .blk-phone { border: 9px solid #111; border-radius: 30px; overflow: hidden; max-width: 260px; background: #111; box-shadow: 0 24px 60px -20px rgba(17,17,17,0.35); }
  .blk-phone img { display: block; width: 100%; height: auto; }
  .blk-cap { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.5px; color: var(--mid-gray); margin-top: 12px; }
  .blk-cap b { color: var(--black); font-weight: 600; }

  /* HERO */
  .blk-hero { padding: calc(var(--nav-h) + 64px) 0 72px; background: linear-gradient(180deg, var(--orange-pale) 0%, #fff 70%); border-bottom: 1px solid var(--border); }
  .blk-hero-inner { display: grid; grid-template-columns: 1fr 1.05fr; gap: 56px; align-items: center; }
  .blk-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--orange); background: #fff; border: 1px solid var(--border); padding: 6px 14px; border-radius: 100px; margin-bottom: 22px; }
  .blk-eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 3px rgba(255,85,0,0.18); }
  .blk-hero-h1 { font-family: 'Bebas Neue', cursive; font-size: clamp(50px, 6.5vw, 88px); line-height: 0.94; letter-spacing: 1.5px; color: var(--black); }
  .blk-hero-h1 span { color: var(--orange); }
  .blk-hero-sub { font-size: 18px; line-height: 1.6; color: #444; max-width: 520px; margin-top: 22px; }
  .blk-hero-cta { margin-top: 32px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .blk-hero-reassure { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--mid-gray); }
  .blk-hero-visual .blk-cap { text-align: left; }

  /* PROBLEM */
  .blk-problem { background: var(--black); color: #fff; padding: 88px 0; }
  .blk-problem .blk-kicker { color: var(--orange); }
  .blk-problem-h2 { font-family: 'Bebas Neue', cursive; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.0; letter-spacing: 2px; color: #fff; max-width: 900px; }
  .blk-problem-h2 span { color: var(--orange); }
  .blk-problem-lines { margin-top: 34px; display: grid; gap: 16px; max-width: 780px; }
  .blk-problem-line { display: flex; gap: 14px; align-items: flex-start; font-size: 17px; line-height: 1.6; color: rgba(255,255,255,0.72); }
  .blk-problem-line svg { width: 20px; height: 20px; stroke: var(--orange); flex: none; margin-top: 2px; }

  /* HOW */
  .blk-how { padding: 92px 0; }
  .blk-how-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
  .blk-how-head .blk-lead { margin-left: auto; margin-right: auto; }
  .blk-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .blk-step { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 32px 28px; position: relative; }
  .blk-step-num { font-family: 'Bebas Neue', cursive; font-size: 46px; line-height: 1; color: var(--orange); letter-spacing: 1px; }
  .blk-step h3 { font-family: 'Bebas Neue', cursive; font-size: 24px; letter-spacing: 1px; color: var(--black); margin: 12px 0 10px; }
  .blk-step p { font-size: 15px; line-height: 1.6; color: var(--text-muted); }
  .blk-how-visual { margin-top: 44px; }
  .blk-how-visual .blk-cap { text-align: center; }

  /* CAPABILITY GRID */
  .blk-caps { padding: 92px 0; background: var(--gray); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .blk-caps-head { max-width: 720px; margin-bottom: 48px; }
  .blk-feature { display: grid; grid-template-columns: 1.15fr 1fr; gap: 44px; align-items: center; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 36px; margin-bottom: 28px; }
  .blk-feature-badge { display: inline-block; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--orange); background: var(--orange-pale); border: 1px solid #ffd9c6; padding: 5px 11px; border-radius: 100px; margin-bottom: 16px; }
  .blk-feature h3 { font-family: 'Bebas Neue', cursive; font-size: clamp(30px, 3.4vw, 44px); line-height: 1; letter-spacing: 1.5px; color: var(--black); }
  .blk-feature p { font-size: 16px; line-height: 1.65; color: var(--text-muted); margin-top: 14px; }
  .blk-cap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
  .blk-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; }
  .blk-card-media { border-radius: 8px; overflow: hidden; margin-bottom: 16px; background: var(--gray); }
  .blk-card-media.is-phone { display: flex; justify-content: center; padding: 14px 0; }
  .blk-card-media.is-phone .blk-phone { max-width: 150px; border-width: 7px; border-radius: 22px; }
  .blk-card-media > img { display: block; width: 100%; height: auto; }
  .blk-card h3 { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 1px; color: var(--black); margin-bottom: 8px; }
  .blk-card p { font-size: 14px; line-height: 1.55; color: var(--text-muted); }

  /* PROOF */
  .blk-proof { padding: 92px 0; }
  .blk-proof-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: center; }
  .blk-proof-points { margin-top: 26px; display: grid; gap: 18px; }
  .blk-proof-point { display: flex; gap: 14px; align-items: flex-start; }
  .blk-proof-point svg { width: 22px; height: 22px; stroke: var(--orange); flex: none; margin-top: 1px; }
  .blk-proof-point b { font-family: 'Barlow', sans-serif; font-weight: 700; color: var(--black); display: block; font-size: 15px; letter-spacing: 0.3px; }
  .blk-proof-point span { font-size: 14px; color: var(--text-muted); line-height: 1.55; }

  /* SUBSCRIPTION (audience B) */
  .blk-sub { padding: 88px 0; background: var(--black); color: #fff; }
  .blk-sub-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .blk-sub .blk-kicker { color: var(--orange); }
  .blk-sub h2 { font-family: 'Bebas Neue', cursive; font-size: clamp(34px, 4.2vw, 54px); line-height: 1; letter-spacing: 2px; color: #fff; }
  .blk-sub h2 span { color: var(--orange); }
  .blk-sub-intro { font-size: 17px; line-height: 1.65; color: rgba(255,255,255,0.7); margin-top: 18px; }
  .blk-sub-bullets { list-style: none; margin: 28px 0 0; display: grid; gap: 18px; }
  .blk-sub-bullets li { display: flex; gap: 14px; align-items: flex-start; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.82); }
  .blk-sub-bullets svg { width: 22px; height: 22px; stroke: var(--orange); flex: none; margin-top: 2px; }
  .blk-sub-cta { margin-top: 34px; }
  .blk-sub-card { background: #1a1a1a; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 40px; }
  .blk-sub-card h3 { font-family: 'Bebas Neue', cursive; font-size: 30px; letter-spacing: 1.5px; color: #fff; }
  .blk-sub-card .blk-sub-card-line { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 1px; color: var(--orange); text-transform: uppercase; margin-bottom: 18px; }
  .blk-sub-card ul { list-style: none; margin-top: 20px; display: grid; gap: 14px; }
  .blk-sub-card li { font-size: 15px; color: rgba(255,255,255,0.72); display: flex; gap: 10px; align-items: flex-start; line-height: 1.55; }
  .blk-sub-card li::before { content: '→'; color: var(--orange); flex: none; }

  /* OFFER RESTATEMENT */
  .blk-offer { padding: 84px 0; background: var(--orange); }
  .blk-offer-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .blk-offer h2 { font-family: 'Bebas Neue', cursive; font-size: clamp(32px, 4vw, 52px); line-height: 1; letter-spacing: 1.5px; color: #fff; max-width: 640px; }
  .blk-offer-right { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .blk-offer .btn-white { background: #fff; color: var(--orange); }
  .blk-offer-reassure { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: rgba(255,255,255,0.85); max-width: 300px; line-height: 1.5; }

  /* FAQ */
  .blk-faq { padding: 92px 0; }
  .blk-faq-head { text-align: center; margin-bottom: 44px; }
  .blk-faq-list { max-width: 820px; margin: 0 auto; }
  .blk-faq-item { border-bottom: 1px solid var(--border); }
  .blk-faq-item summary { cursor: pointer; list-style: none; padding: 22px 0; display: flex; justify-content: space-between; align-items: center; gap: 20px; font-family: 'Barlow', sans-serif; font-weight: 700; font-size: 17px; color: var(--black); }
  .blk-faq-item summary::-webkit-details-marker { display: none; }
  .blk-faq-item summary::after { content: '+'; font-size: 24px; font-weight: 300; color: var(--orange); flex: none; transition: transform 0.2s; }
  .blk-faq-item[open] summary::after { content: '−'; }
  .blk-faq-item p { font-size: 15px; line-height: 1.7; color: var(--text-muted); padding: 0 0 24px; max-width: 720px; }

  /* CTA buttons reused from BaseLayout: .btn-primary, .btn-white, .btn-outline */

  @media (max-width: 980px) {
    .blk-hero-inner, .blk-proof-inner, .blk-sub-inner, .blk-feature { grid-template-columns: 1fr; gap: 34px; }
    .blk-steps { grid-template-columns: 1fr; }
    .blk-hero { padding-top: calc(var(--nav-h) + 40px); }
    .blk-feature { padding: 24px; }
  }
  @media (max-width: 640px) {
    .blk { --pad-x: 22px; }
    .blk-problem, .blk-how, .blk-caps, .blk-proof, .blk-sub, .blk-faq { padding-top: 60px; padding-bottom: 60px; }
    .blk-offer { padding: 56px 0; }
    .blk-hero-cta { flex-direction: column; align-items: flex-start; gap: 14px; }
    .blk-cap-grid { grid-template-columns: 1fr; }
    .blk-sub-card { padding: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blk-faq-item summary::after { transition: none; }
  }
</style>

<div class="blk">

  <!-- ══ 1 · HERO ══════════════════════════════════════════════ -->
  <section class="blk-hero">
    <div class="blk-container blk-hero-inner">
      <div class="blk-hero-copy fade-up">
        <span class="blk-eyebrow">Built &amp; run in-house by Elitez FMCG</span>
        <h1 class="blk-hero-h1">Your activation, <span>live on a map.</span><br>Your sales data, <span>same day.</span></h1>
        <p class="blk-hero-sub">Blink is the operations platform behind every Elitez FMCG activation — and the client dashboard that puts every shift, sale and sample at your fingertips.</p>
        <div class="blk-hero-cta">
          <a href="/pages/contact?interest=blink-demo" class="btn-primary">See a live demo of your campaign dashboard →</a>
        </div>
        <p class="blk-hero-reassure" style="margin-top:16px;">No agency in Singapore gives brands this. We do — as standard.</p>
      </div>
      <div class="blk-hero-visual fade-up delay-1">
        <div class="blk-browser">
          <div class="blk-browser-bar"><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-url">app.blink.elitez — live deployment map</span></div>
          <img src="/assets/blink/blink-client-live-map.webp" width="1600" height="797" alt="Blink client dashboard showing a live map of promoter check-ins across Singapore outlets" loading="eager" fetchpriority="high">
        </div>
        <p class="blk-cap"><b>Your live deployment map</b> — every promoter check-in on one screen, as it happens.</p>
      </div>
    </div>
  </section>

  <!-- ══ 2 · PROBLEM ═══════════════════════════════════════════ -->
  <section class="blk-problem">
    <div class="blk-container">
      <p class="blk-kicker fade-up">The brief-and-go-blind problem</p>
      <h2 class="blk-problem-h2 fade-up">You brief the agency, then you <span>lose sight of your own campaign.</span></h2>
      <div class="blk-problem-lines">
        <div class="blk-problem-line fade-up"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span>Updates arrive as a stream of WhatsApp photos — no way to tell what’s staffed right now.</span></div>
        <div class="blk-problem-line fade-up delay-1"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span>Sales land as a spreadsheet at month-end — long after you could have acted on them.</span></div>
        <div class="blk-problem-line fade-up delay-2"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span>Nobody can say which outlets are covered today, what sold, or where the booth and leftover stock went.</span></div>
      </div>
    </div>
  </section>

  <!-- ══ 3 · HOW IT WORKS ══════════════════════════════════════ -->
  <section class="blk-how">
    <div class="blk-container">
      <div class="blk-how-head fade-up">
        <p class="blk-kicker" style="text-align:center;">How it works</p>
        <h2 class="blk-h2">Brief us once.<br><span>Watch it run.</span></h2>
        <p class="blk-lead">Three steps from campaign brief to same-day data — with none of the chasing.</p>
      </div>
      <div class="blk-steps">
        <div class="blk-step fade-up">
          <div class="blk-step-num">01</div>
          <h3>We deploy &amp; remind</h3>
          <p>Trained promoters are scheduled across your outlets and reminded automatically over WhatsApp — confirmations and change notices go out without anyone chasing.</p>
        </div>
        <div class="blk-step fade-up delay-1">
          <div class="blk-step-num">02</div>
          <h3>The floor reports in</h3>
          <p>Every shift is GPS check-in verified. Sales, sampling and stock counts are submitted straight from the shop floor — mid-shift and at closing.</p>
        </div>
        <div class="blk-step fade-up delay-2">
          <div class="blk-step-num">03</div>
          <h3>You open your dashboard</h3>
          <p>Log in to a live map, same-day sales with SKU breakdown, Excel exports, and campaign wrap-ups with photo galleries — 24/7.</p>
        </div>
      </div>
      <div class="blk-how-visual fade-up">
        <div class="blk-browser">
          <div class="blk-browser-bar"><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-url">app.blink.elitez — operations grid</span></div>
          <img src="/assets/blink/blink-admin-grid.webp" width="1600" height="797" alt="Blink operations grid showing scheduled shifts, promoters and outlets across the week" loading="lazy">
        </div>
        <p class="blk-cap">The ops grid our team runs every deployment from — the same live data that feeds your dashboard.</p>
      </div>
    </div>
  </section>

  <!-- ══ 4 · CAPABILITY GRID ═══════════════════════════════════ -->
  <section class="blk-caps">
    <div class="blk-container">
      <div class="blk-caps-head fade-up">
        <p class="blk-kicker">What Blink gives you</p>
        <h2 class="blk-h2">Every part of the campaign, <span>in one place.</span></h2>
      </div>

      <!-- Featured / differentiator card: Client dashboard -->
      <div class="blk-feature fade-up">
        <div>
          <span class="blk-feature-badge">The differentiator</span>
          <h3>Client dashboard — your campaigns, your data, 24/7</h3>
          <p>The one thing no other agency in Singapore hands you: a secure login to your own campaigns. Real-time deployment map, approved sales reports with SKU breakdowns and Excel export, your promoter roster with favourite and blacklist controls, the inventory we hold for you, and wrap-up summaries with photo galleries. Not a WhatsApp photo dump and a spreadsheet two weeks later.</p>
        </div>
        <div>
          <div class="blk-browser">
            <div class="blk-browser-bar"><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-dot"></span><span class="blk-url">app.blink.elitez — client dashboard</span></div>
            <img src="/assets/blink/blink-client-dashboard.webp" width="1600" height="797" alt="Blink client dashboard home showing campaigns, sales and inventory at a glance" loading="lazy">
          </div>
          <p class="blk-cap">Your home screen on Blink — every live campaign at a glance.</p>
        </div>
      </div>

      <!-- Remaining 7 capability cards -->
      <div class="blk-cap-grid">
        {caps.map((c) => (
          <div class="blk-card fade-up">
            {c.frame === 'phone' ? (
              <div class="blk-card-media is-phone">
                <div class="blk-phone"><img src={`/assets/blink/${c.img}`} width="600" height="1301" alt={c.title} loading="lazy" /></div>
              </div>
            ) : (
              <div class="blk-card-media"><img src={`/assets/blink/${c.img}`} width="1600" height="797" alt={c.title} loading="lazy" /></div>
            )}
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
      {/* Returns-checklist screenshot not yet available — drop blink-returning-checklist.png
          into /assets/blink/ and add a card here (logistics card covers returns in copy for now). */}
    </div>
  </section>

  <!-- ══ 5 · PROOF (dashboard walkthrough) ═════════════════════ -->
  <section class="blk-proof">
