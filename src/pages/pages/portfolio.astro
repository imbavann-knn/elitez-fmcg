---
import BaseLayout from '../../layouts/BaseLayout.astro';
import portfolioItems from '../../data/portfolio.json';

const CAT_LABELS: Record<string, string> = {
  'brand-activation': 'Brand Activation',
  'promoter': 'Promoter Deployment',
  'roadshow': 'Roadshow',
  'kol': 'KOL & Events'
};
---
<BaseLayout
  title="Portfolio | Elitez FMCG Singapore"
  description="Elitez FMCG's portfolio of brand activations and field marketing campaigns across Singapore."
  canonical="https://fmcg.elitez.ai/pages/portfolio"
  keywords="FMCG portfolio Singapore, brand activation portfolio"
>
<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --orange: #FF5500;
    --orange-hover: #E84A00;
    --orange-pale: #FFF3EE;
    --black: #111111;
    --white: #FFFFFF;
    --off-white: #FAFAF8;
    --gray: #F4F4F2;
    --border: #E8E8E5;
    --text-muted: #777;
    --nav-h: 72px;
  }

  html { scroll-behavior: smooth; }
  body { font-family: 'Barlow', sans-serif; background: var(--white); color: var(--black); -webkit-font-smoothing: antialiased; overflow-x: hidden; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    height: var(--nav-h);
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 48px;
    transition: box-shadow 0.3s;
  }
  nav.scrolled { box-shadow: 0 2px 24px rgba(0,0,0,0.08); }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo img { height: 44px; width: auto; }
  .nav-logo-text { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 3px; color: var(--black); line-height: 1; }
  .nav-logo-text span { color: var(--orange); }
  .nav-links { display: flex; align-items: center; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #888; text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--black); }
  .nav-cta { background: var(--orange) !important; color: var(--white) !important; padding: 10px 22px; border-radius: 3px; transition: background 0.2s !important; }
  .nav-cta:hover { background: var(--orange-hover) !important; }

  /* PAGE HEADER */
  .page-header { padding-top: var(--nav-h); background: var(--black); }
  .page-header-inner { padding: 72px 48px 0; position: relative; overflow: hidden; }
  .page-header-inner::before { content: 'WORK'; position: absolute; top: 0; right: -10px; font-family: 'Bebas Neue', cursive; font-size: 220px; letter-spacing: 8px; color: rgba(255,255,255,0.02); pointer-events: none; line-height: 1; }
  .breadcrumb { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 20px; }
  .breadcrumb a { color: var(--orange); text-decoration: none; }
  .page-header-inner h1 { font-family: 'Bebas Neue', cursive; font-size: clamp(56px, 7vw, 96px); letter-spacing: 3px; color: var(--white); line-height: 0.9; margin-bottom: 20px; }
  .page-header-inner h1 span { color: var(--orange); }
  .page-header-inner > p { font-size: 16px; font-weight: 500; color: rgba(255,255,255,0.5); max-width: 520px; line-height: 1.65; }
  .header-stats { display: flex; border-top: 1px solid rgba(255,255,255,0.07); margin-top: 48px; }
  .header-stat { flex: 1; padding: 20px 32px; border-right: 1px solid rgba(255,255,255,0.07); }
  .header-stat:last-child { border-right: none; }
  .header-stat-num { font-family: 'Bebas Neue', cursive; font-size: 36px; color: var(--orange); letter-spacing: 2px; line-height: 1; }
  .header-stat-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-top: 3px; }

  /* FILTER BAR */
  .filter-bar {
    padding: 32px 48px 0;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .filter-bar::-webkit-scrollbar { display: none; }
  .filter-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    padding: 8px 18px 16px;
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.2s, border-color 0.2s;
  }
  .filter-btn:hover { color: var(--black); }
  .filter-btn.active { color: var(--orange); border-bottom-color: var(--orange); }

  /* PORTFOLIO GRID */
  .portfolio-section { padding: 56px 48px 96px; }
  .portfolio-count {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 32px;
  }
  .portfolio-count span { color: var(--orange); }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .portfolio-item {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 4/3;
    background: var(--gray);
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  .portfolio-item.featured {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .portfolio-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .portfolio-item:hover img { transform: scale(1.06); }

  .portfolio-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(17,17,17,0.85) 0%, rgba(17,17,17,0.1) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
  }
  .portfolio-item:hover .portfolio-overlay { opacity: 1; }
  .portfolio-item.featured .portfolio-overlay { opacity: 1; background: linear-gradient(to top, rgba(17,17,17,0.75) 0%, transparent 60%); }

  .portfolio-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 6px;
  }
  .portfolio-name {
    font-family: 'Bebas Neue', cursive;
    font-size: 22px;
    letter-spacing: 2px;
    color: var(--white);
    line-height: 1;
  }
  .portfolio-item.featured .portfolio-name { font-size: 32px; }

  .portfolio-item.hidden { display: none; }

  /* CTA */
  .page-cta { background: var(--orange); padding: 80px 48px; position: relative; overflow: hidden; }
  .page-cta::before { content: ''; position: absolute; top: -80px; right: -80px; width: 400px; height: 400px; border: 80px solid rgba(255,255,255,0.07); border-radius: 50%; }
  .page-cta-inner { display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 1; gap: 40px; }
  .page-cta h2 { font-family: 'Bebas Neue', cursive; font-size: clamp(44px, 5vw, 68px); letter-spacing: 3px; color: var(--white); line-height: 0.9; margin-bottom: 12px; }
  .page-cta p { font-size: 16px; color: rgba(255,255,255,0.7); max-width: 440px; line-height: 1.6; }
  .btn-white { display: inline-flex; align-items: center; gap: 8px; background: var(--white); color: var(--orange); font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 14px 28px; border-radius: 3px; text-decoration: none; white-space: nowrap; transition: transform 0.15s; flex-shrink: 0; }
  .btn-white:hover { transform: translateY(-2px); }

  footer { background: var(--black); padding: 32px 48px; }
  .footer-bar { display: flex; justify-content: space-between; align-items: center; }
  .footer-logo-img { height: 36px; width: auto; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--white); }
  .footer-copy { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.2); }

  .fade-up { opacity: 0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 1100px) {
    .portfolio-grid { grid-template-columns: repeat(3, 1fr); }
    .portfolio-item.featured { grid-column: span 2; }
  }
  @media (max-width: 900px) {
    nav { padding: 0 24px; } .nav-links { display: none; }
    .page-header-inner { padding: 48px 24px 0; }
    .header-stats { flex-wrap: wrap; }
    .header-stat { min-width: 50%; }
    .filter-bar { padding: 24px 24px 0; }
    .portfolio-section { padding: 40px 24px 64px; }
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .portfolio-item.featured { grid-column: span 2; }
    .page-cta { padding: 60px 24px; }
    .page-cta-inner { flex-direction: column; align-items: flex-start; }
    footer { padding: 32px 24px; }
    .footer-bar { flex-direction: column; gap: 16px; text-align: center; }
  }
  @media (max-width: 560px) {
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
    .portfolio-item.featured { grid-column: span 2; }
  }
</style>

<div class="page-header">
  <div class="page-header-inner">
    <div class="breadcrumb"><a href="../">Home</a> / Portfolio</div>
    <h1>ACTIVATIONS <span>ON THE GROUND</span></h1>
    <p>Real campaigns, real results — across supermarkets, malls, getais and beyond.</p>
    <div class="header-stats">
      <div class="header-stat"><div class="header-stat-num">300+</div><div class="header-stat-label">Promoters Weekly</div></div>
      <div class="header-stat"><div class="header-stat-num">100+</div><div class="header-stat-label">Retail Outlets</div></div>
      <div class="header-stat"><div class="header-stat-num">15+</div><div class="header-stat-label">Yrs in Market</div></div>
      <div class="header-stat"><div class="header-stat-num">20+</div><div class="header-stat-label">Active Brands</div></div>
    </div>
  </div>
</div>

<!-- FILTER -->
<div class="filter-bar">
  <button class="filter-btn active" data-filter="all">All Projects</button>
  <button class="filter-btn" data-filter="brand-activation">Brand Activation</button>
  <button class="filter-btn" data-filter="promoter">Promoter Deployment</button>
  <button class="filter-btn" data-filter="roadshow">Roadshows</button>
  <button class="filter-btn" data-filter="kol">KOL & Events</button>
</div>

<!-- GRID — rendered statically at build time -->
<section class="portfolio-section">
  <div class="portfolio-count fade-up">Showing <span id="visible-count">{portfolioItems.length}</span> projects</div>
  <div class="portfolio-grid" id="portfolio-grid">
    {portfolioItems.map((item, i) => (
      <div
        class={['portfolio-item', i === 0 ? 'featured' : '', 'fade-up', ['','delay-1','delay-2','delay-3'][i % 4]].filter(Boolean).join(' ')}
        data-category={item.category}
      >
        <img src={item.image} alt={item.title} loading={i < 4 ? 'eager' : 'lazy'} />
        <div class="portfolio-overlay">
          <div class="portfolio-tag">{CAT_LABELS[item.category] || item.category}</div>
          <div class="portfolio-name">{item.title}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- CTA -->
<div class="page-cta">
  <div class="page-cta-inner">
    <div>
      <h2>READY TO BE ON <span style="color:rgba(255,255,255,0.85)">THIS LIST?</span></h2>
      <p>Tell us your brief and we'll put together a field marketing proposal within 48 hours.</p>
    </div>
    <a href="contact" class="btn-white">Get a Proposal →</a>
  </div>
</div>

<script is:inline>
  var activeFilter = 'all';
  var allItems = Array.from(document.querySelectorAll('#portfolio-grid .portfolio-item'));

  function updateGrid() {
    var visibleCount = 0;
    allItems.forEach(function(item) {
      var matches = activeFilter === 'all' || item.dataset.category === activeFilter;
      item.classList.toggle('hidden', !matches);
      if (matches) visibleCount++;
    });
    document.getElementById('visible-count').textContent = String(visibleCount);

    // Re-assign featured to first visible item when showing all
    allItems.forEach(function(item) { item.classList.remove('featured'); });
    if (activeFilter === 'all') {
      var first = allItems.find(function(item) { return !item.classList.contains('hidden'); });
      if (first) first.classList.add('featured');
    }

    if (typeof posthog !== 'undefined') {
      posthog.capture('portfolio_filter_applied', { filter: activeFilter });
    }
  }

  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activeFilter = btn.dataset.filter || 'all';
      updateGrid();
    });
  });
</script>
</BaseLayout>
