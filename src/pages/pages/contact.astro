    <!-- INFO -->
    <div class="contact-info-side fade-up">
      <h2 class="info-heading">REACH US <span>DIRECTLY</span></h2>
      <p class="info-sub">Prefer to talk first? Reach out directly — we're happy to jump on a call to understand your needs before we put a proposal together.</p>

      <div class="contact-cards">
