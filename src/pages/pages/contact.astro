</Fragment>
<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  :root { --orange: #FF5500; --orange-hover: #E84A00; --orange-pale: #FFF3EE; --black: #111; --white: #fff; --gray: #F4F4F2; --mid-gray: #888; --border: #E8E8E5; --text-muted: #777; --nav-h: 72px; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Barlow', sans-serif; background: var(--white); color: var(--black); -webkit-font-smoothing: antialiased; overflow-x: hidden; }

  nav { position: fixed; top: 0; left: 0; right: 0; height: var(--nav-h); background: rgba(255,255,255,0.96); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 0 48px; }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo img { height: 44px; width: auto; }
  .nav-logo-text { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 3px; color: var(--black); }
  .nav-logo-text span { color: var(--orange); }
  .nav-links { display: flex; align-items: center; gap: 32px; list-style: none; }
  .nav-links a { font-family: 'Barlow', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #888; text-decoration: none; transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--black); }
  .nav-cta { background: var(--orange) !important; color: var(--white) !important; padding: 10px 22px; border-radius: 3px; }
  .nav-cta:hover { background: var(--orange-hover) !important; }
  /* SERVICES DROPDOWN */
  .has-dropdown { position: relative; align-self: stretch; display: flex; align-items: center; }
  .has-dropdown > a { display: flex; align-items: center; gap: 4px; }
  .has-dropdown > a::after { content: '▾'; font-size: 11px; opacity: 0.5; transition: opacity 0.2s; }
  .has-dropdown:hover > a::after { opacity: 1; }
  .nav-dropdown { position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(-4px); background: var(--white); border: 1px solid var(--border); border-top: 3px solid var(--orange); border-radius: 0 0 4px 4px; padding: 4px 0; min-width: 220px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; z-index: 200; }
  .nav-dropdown::before { display: none; }
  .has-dropdown:hover .nav-dropdown { opacity: 1; pointer-events: all; transform: translateX(-50%) translateY(0); }
  .nav-dropdown a { display: block !important; padding: 9px 18px; font-family: 'Barlow', sans-serif !important; font-size: 11px !important; font-weight: 700 !important; letter-spacing: 1.5px !important; text-transform: uppercase !important; color: #888 !important; background: none !important; transition: color 0.15s, background 0.15s !important; white-space: nowrap; border-radius: 0 !important; }
  .nav-dropdown a:hover { color: var(--orange) !important; background: var(--orange-pale) !important; }

  /* HERO */
  .contact-hero { padding-top: var(--nav-h); background: var(--black); }
  .contact-hero-inner { padding: 72px 48px 60px; position: relative; overflow: hidden; }
  .contact-hero-inner::before { content: 'CONTACT'; position: absolute; top: 0; right: -10px; font-family: 'Bebas Neue', cursive; font-size: 180px; letter-spacing: 6px; color: rgba(255,255,255,0.02); pointer-events: none; line-height: 1; }
  .breadcrumb { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 20px; }
  .breadcrumb a { color: var(--orange); text-decoration: none; }
  .contact-hero-inner h1 { font-family: 'Bebas Neue', cursive; font-size: clamp(56px, 7vw, 96px); letter-spacing: 3px; color: var(--white); line-height: 0.9; margin-bottom: 20px; }
  .contact-hero-inner h1 span { color: var(--orange); }
  .contact-hero-inner > p { font-size: 16px; font-weight: 500; color: rgba(255,255,255,0.5); max-width: 480px; line-height: 1.65; }

  /* MAIN CONTACT SECTION */
  .contact-main { padding: 96px 48px; background: var(--white); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }

  /* FORM */
  .contact-form-side {}
  .form-heading { font-family: 'Bebas Neue', cursive; font-size: 36px; letter-spacing: 3px; color: var(--black); margin-bottom: 8px; }
  .form-heading span { color: var(--orange); }
  .form-sub { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 32px; }

  form { display: flex; flex-direction: column; gap: 20px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--mid-gray); }
  .form-group input:not([type="checkbox"]),
  .form-group select,
  .form-group textarea {
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--black);
    background: var(--gray);
    border: 2px solid transparent;
    border-radius: 4px;
    padding: 12px 16px;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    width: 100%;
    -webkit-appearance: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: var(--orange); background: var(--white); }
  .form-group textarea { resize: vertical; min-height: 120px; }
  .form-group select { cursor: pointer; }

  .checkboxes { display: flex; flex-direction: column; gap: 10px; }
  .checkbox-item { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  .checkbox-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--orange); cursor: pointer; flex-shrink: 0; }
  .checkbox-item span { font-size: 13px; color: #555; }

  .submit-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--orange); color: var(--white);
    font-family: 'Barlow', sans-serif; font-size: 13px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    padding: 16px 32px; border-radius: 3px; border: none;
    cursor: pointer; transition: background 0.2s, transform 0.15s;
    width: 100%;
  }
  .submit-btn:hover { background: var(--orange-hover); transform: translateY(-1px); }

  .form-note { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--mid-gray); text-align: center; margin-top: -8px; }

  /* CONTACT INFO SIDE */
  .contact-info-side {}
  .info-heading { font-family: 'Bebas Neue', cursive; font-size: 36px; letter-spacing: 3px; color: var(--black); margin-bottom: 8px; }
  .info-heading span { color: var(--orange); }
  .info-sub { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 36px; }

  .contact-cards { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; }
  .contact-card { background: var(--gray); border-radius: 8px; padding: 24px; display: flex; gap: 16px; align-items: flex-start; border-left: 4px solid var(--orange); }
  .contact-card-icon { font-size: 22px; flex-shrink: 0; }
  .contact-card-text h4 { font-family: 'Barlow', sans-serif; font-size: 14px; font-weight: 700; color: var(--black); margin-bottom: 4px; }
  .contact-card-text a, .contact-card-text p { font-size: 14px; color: var(--text-muted); text-decoration: none; line-height: 1.6; display: block; transition: color 0.2s; }
  .contact-card-text a:hover { color: var(--orange); }

  .response-promise { background: var(--black); border-radius: 8px; padding: 28px; }
  .response-promise h4 { font-family: 'Bebas Neue', cursive; font-size: 24px; letter-spacing: 2px; color: var(--white); margin-bottom: 12px; }
  .response-promise h4 span { color: var(--orange); }
  .response-promise p { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6; }
  .promise-list { list-style: none; margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  .promise-list li { font-size: 13px; color: rgba(255,255,255,0.6); padding-left: 16px; position: relative; line-height: 1.4; }
  .promise-list li::before { content: '✓'; position: absolute; left: 0; color: var(--orange); font-weight: 700; font-size: 12px; }

  /* SUCCESS STATE */
  .form-success { display: none; text-align: center; padding: 60px 32px; background: var(--gray); border-radius: 8px; }
  .form-success.show { display: block; }
  .form-success-icon { font-size: 48px; margin-bottom: 16px; }
  .form-success h3 { font-family: 'Bebas Neue', cursive; font-size: 36px; letter-spacing: 3px; color: var(--black); margin-bottom: 8px; }
  .form-success p { font-size: 15px; color: var(--text-muted); line-height: 1.6; }

  footer { background: var(--black); padding: 32px 48px; }
  .footer-bar { display: flex; justify-content: space-between; align-items: center; }
  .footer-logo-img { height: 36px; width: auto; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.3); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--white); }
  .footer-copy { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.2); }

  .fade-up { opacity: 0; transform: translateY(28px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .fade-up.visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 900px) {
    nav { padding: 0 24px; } .nav-links { display: none; }
    .contact-hero-inner { padding: 48px 24px 40px; }
    .contact-main { padding: 64px 24px; }
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
    .form-row { grid-template-columns: 1fr; }
    footer { padding: 32px 24px; }
    .footer-bar { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>

<div class="contact-hero">
  <div class="contact-hero-inner">
    <div class="breadcrumb"><a href="../">Home</a> / Contact</div>
    <h1><span>LET'S</span> BUILD YOUR <span>NEXT<br>CAMPAIGN.</span></h1>
    <p>Send us your brief and we'll respond with a tailored proposal within 48 hours.</p>
  </div>
</div>

<section class="contact-main">
  <div class="contact-grid">

    <!-- FORM -->
    <div class="contact-form-side fade-up">
      <h2 class="form-heading">GET A <span>QUOTE</span></h2>
      <p class="form-sub">Fill in the form and we'll get back to you within 48 hours with a tailored proposal.</p>

      <form id="contactForm">
        <input type="hidden" name="_subject" value="New Campaign Enquiry — Elitez FMCG">
        <input type="hidden" name="_autoresponse" value="Hi, thanks for reaching out to Elitez FMCG! We've received your brief and will respond within 48 hours with a tailored proposal. If you have urgent needs, feel free to call us at +65 8180 0994. — The Elitez FMCG Team">
